{% set t = i18n[lang] %}
{% set home = "/" if lang == "ro" else "/en/" %}
<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or site.name }}</title>
  <meta name="description" content="{{ description or site[lang].intro }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {% if urlRo and urlEn %}
  <link rel="alternate" hreflang="ro" href="{{ site.url }}{{ urlRo }}">
  <link rel="alternate" hreflang="en" href="{{ site.url }}{{ urlEn }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ urlRo }}">
  {% endif %}
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site[lang].intro }}">
  <meta property="og:image" content="{{ site.url }}{{ ogImage or site.heroImage }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta name="theme-color" content="#BE8A2E">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.name }}">
  <meta name="twitter:description" content="{{ description or site[lang].intro }}">
  <meta name="twitter:image" content="{{ site.url }}{{ ogImage or site.heroImage }}">
  <meta name="geo.region" content="RO-PH">
  <meta name="geo.placename" content="Sinaia">
  <meta name="geo.position" content="45.3489;25.5527">
  <meta name="ICBM" content="45.3489, 25.5527">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Ccircle cx='12' cy='12' r='2' fill='%23BE8A2E'/%3E%3Cg stroke='%23BE8A2E' stroke-width='1' stroke-linecap='round'%3E%3Cline x1='12' y1='12' x2='12' y2='3'/%3E%3Cline x1='12' y1='12' x2='19' y2='7'/%3E%3Cline x1='12' y1='12' x2='21' y2='13'/%3E%3Cline x1='12' y1='12' x2='5' y2='7'/%3E%3Cline x1='12' y1='12' x2='3' y2='13'/%3E%3Cline x1='12' y1='12' x2='7' y2='20'/%3E%3Cline x1='12' y1='12' x2='17' y2='20'/%3E%3C/g%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LodgingBusiness",
    "name": "{{ site.name }}",
    "description": "{{ site[lang].intro }}",
    "address": { "@type": "PostalAddress", "streetAddress": "{{ site.address }}", "addressLocality": "Sinaia", "addressCountry": "RO" },
    "url": "{{ site.url }}",
    "image": "{{ site.url }}{{ ogImage or site.heroImage }}",
    "geo": { "@type": "GeoCoordinates", "latitude": "45.3489", "longitude": "25.5527" },
    "priceRange": "$$",
    "aggregateRating": { "@type": "AggregateRating", "ratingValue": "9.9", "bestRating": "10", "ratingCount": "25" }
  }
  </script>
  {% if faq %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {% for f in faq %}{ "@type": "Question", "name": "{{ f['q_' ~ lang] }}", "acceptedAnswer": { "@type": "Answer", "text": "{{ f['a_' ~ lang] }}" } }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  {% endif %}
</head>
<body>
  <header class="nav">
    <div class="wrap nav-in">
      <a href="{{ home }}" class="brand" aria-label="Studio Dandelion">
        <img src="/assets/img/brand/logo-gold.png" alt="Studio Dandelion" class="brand-logo logo-dark" width="421" height="198">
        <img src="/assets/img/brand/logo-green.png" alt="" aria-hidden="true" class="brand-logo logo-light" width="421" height="198">
      </a>
      <button class="nav-toggle" id="navToggle" type="button" aria-label="{{ 'Meniu' if lang == 'ro' else 'Menu' }}" aria-expanded="false" aria-controls="navLinks">
        <span></span><span></span><span></span>
      </button>
      <nav class="nav-links" id="navLinks">
        <a href="{{ home }}#galerie">{{ t.nav_gallery }}</a>
        <a href="{{ '/tur-video/' if lang == 'ro' else '/en/video-tour/' }}">{{ t.nav_video }}</a>
        <a href="{{ home }}#facilitati">{{ t.nav_facilities }}</a>
        <a href="{{ home }}#sinaia">{{ t.nav_sinaia }}</a>
        <a href="{{ home }}#recenzii">{{ t.nav_reviews }}</a>
        {% if urlRo and urlEn %}
        <span class="lang-switch">
          <a href="{{ urlRo }}"{% if lang == "ro" %} class="on"{% endif %}>RO</a>
          <a href="{{ urlEn }}"{% if lang == "en" %} class="on"{% endif %}>EN</a>
        </span>
        {% endif %}
        <button class="theme-toggle" id="tt" aria-label="Theme" type="button">◐</button>
        <a href="{{ home }}#rezervare" class="btn btn-ochre nav-book">{{ t.nav_book }}</a>
      </nav>
    </div>
  </header>

  {{ content | safe }}

  <footer>
    <div class="wrap">
      <div class="foot-grid">
        <div class="brand foot-brand">
          <img src="/assets/img/brand/logo-gold.png" alt="Studio Dandelion" class="brand-logo logo-dark" width="421" height="198">
          <img src="/assets/img/brand/logo-green.png" alt="" aria-hidden="true" class="brand-logo logo-light" width="421" height="198">
          <small style="display:block;font-size:.62rem;letter-spacing:.3em;text-transform:uppercase;color:var(--muted);margin-top:.5rem">{{ site.address }}</small>
        </div>
        <nav style="display:flex;gap:1.3rem;flex-wrap:wrap">
          <a href="{{ home }}#galerie">{{ t.nav_gallery }}</a><a href="{{ home }}#facilitati">{{ t.nav_facilities }}</a><a href="{{ home }}#sinaia">{{ t.nav_sinaia }}</a><a href="{{ home }}#rezervare">{{ t.nav_book }}</a>
        </nav>
      </div>
    </div>
  </footer>

  <script src="/assets/js/theme.js" defer></script>
  <script src="/assets/js/slideshow.js" defer></script>
  <script src="/assets/js/reveal.js" defer></script>
  <script src="/assets/js/nav.js" defer></script>
</body>
</html>
